{
  "name": "rumi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Spanish app for a five-year-old who cannot read yet. One self-contained HTML file.",
  "license": "UNLICENSED",
  "scripts": {
    "check": "node scripts/ci-check.mjs",
    "test:rumi": "node scripts/rumi-unit-test.mjs",
    "test:audio": "node scripts/rumi-audio-smoke.mjs",
    "rumi:strings": "node scripts/rumi-strings.mjs",
    "rumi:audio": "node scripts/rumi-audio.mjs",
    "rumi:cues": "node scripts/rumi-cues.mjs",
    "rumi:extract": "node scripts/rumi-extract.mjs",
    "rumi:trim-audit": "node scripts/rumi-trim-audit.mjs",
    "rumi:bakeoff": "node scripts/rumi-bakeoff.mjs",
    "rumi:embed": "node scripts/rumi-audio.mjs --map && node scripts/rumi-cues.mjs --map && node scripts/rumi-embed.mjs",
    "rumi:11:estimate": "node scripts/rumi-eleven.mjs --estimate",
    "rumi:11:balance": "node --env-file=.env.local scripts/rumi-eleven.mjs --balance",
    "rumi:11:voices": "node --env-file=.env.local scripts/rumi-eleven.mjs --voices",
    "rumi:11:audio": "node --env-file=.env.local scripts/rumi-eleven.mjs",
    "rumi:11:cues": "node --env-file=.env.local scripts/rumi-eleven.mjs --cues",
    "rumi:11:bakeoff": "node --env-file=.env.local scripts/rumi-eleven-bakeoff.mjs",
    "rumi:11:bakeoff:dry": "node scripts/rumi-eleven-bakeoff.mjs --dry",
    "rumi:11:shared": "node --env-file=.env.local scripts/rumi-eleven.mjs --shared es",
    "rumi:11:embed": "node --env-file=.env.local scripts/rumi-eleven.mjs --map && node --env-file=.env.local scripts/rumi-eleven.mjs --cues --map && node scripts/rumi-embed.mjs",
    "rumi:11:seed": "node scripts/rumi-seed-cache.mjs",
    "rumi:11:seed:dry": "node scripts/rumi-seed-cache.mjs --dry",
    "rumi:11:packs": "node --env-file=.env.local scripts/rumi-packs.mjs",
    "rumi:11:packs:maps": "node scripts/rumi-packs.mjs --maps-only",
    "rumi:11:packs:only": "node scripts/rumi-packs.mjs --packs-only",
    "rumi:voices": "node scripts/rumi-voices.mjs",
    "stamp": "node scripts/rumi-stamp.mjs"
  }
}
